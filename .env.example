# ---------- Shared ----------
APP_ENV=development                # development | test | production
# ---------- Database (docker-compose.yml exposes 5433) ----------
DATABASE_URL=postgresql+psycopg://fasalalert:fasalalert_dev@localhost:5433/fasalalert
TEST_DATABASE_URL=postgresql+psycopg://fasalalert:fasalalert_dev@localhost:5433/fasalalert_test
POSTGRES_PASSWORD=fasalalert_dev
# ---------- Security (the API refuses to start in production with defaults) ----------
JWT_SECRET=change-me-dev-only
OTP_PEPPER=change-me-dev-only
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000
# ---------- Weather (Open-Meteo needs no key; CC BY 4.0) ----------
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ENSEMBLE_URL=https://ensemble-api.open-meteo.com/v1/ensemble
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_PREVIOUS_RUNS_URL=https://previous-runs-api.open-meteo.com/v1/forecast
# IMD API (free key: https://api.imd.gov.in/public/register.php). Empty = IMD API features disabled.
IMD_API_KEY=
# ---------- Market (AGMARKNET via data.gov.in, key: https://data.gov.in/user/register) ----------
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# ---------- Geography ----------
OPENTOPODATA_URL=https://api.opentopodata.org/v1/srtm30m
# Public OSRM demo is for light development use only; run your own OSRM for production.
OSRM_URL=https://router.project-osrm.org
# ---------- Voice (Bhashini / ULCA; register at https://bhashini.gov.in/ulca) ----------
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# Optional local Whisper fallback: install with `uv sync --extra whisper`, then set e.g. small
WHISPER_MODEL=
# ---------- RAG ----------
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIM=768
# ---------- Groq LLM (Ask assistant; optional) ----------
# When set, Ask drafts answers with Qwen on Groq from grounded field + RAG context.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# ---------- Notifications ----------
SMS_PROVIDER=dev_outbox            # dev_outbox (development only) | twilio | none
DEV_OUTBOX_DIR=                    # optional; default apps/api/data/dev_outbox (OTP codes land in sms.jsonl there)
DEMO_OTP_VISIBLE=true              # show the live OTP on the sign-in screen (dev_outbox only; refused in production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_PROVIDER=none             # none | meta_cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Generate with: uv run python scripts/generate_vapid.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
# Origin printed on the last line of OTP SMS for WebOTP autofill (no scheme)
WEB_OTP_ORIGIN=localhost
KISAN_CALL_CENTRE=1800-180-1551
# ---------- Workers ----------
SCHEDULER_ENABLED=true

# ---------- Web (apps/web/.env.local) ----------
API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=
