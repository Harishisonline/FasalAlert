# Server-side base URL of the FastAPI backend (never exposed to the browser)
API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Web Push VAPID public key. Empty disables push with an honest message.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Social links for the Settings About block and MoreDrawer. Empty hides a link.
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_GITHUB_URL=
